# MCP Connectors Frontend 환경 변수 (cp .env.example .env.local)
# 모두 서버 측(Route Handler, 서버 컴포넌트)에서만 읽고 브라우저로는 내려가지 않습니다.
# docker compose 로 띄울 때는 이 파일 대신 루트 .env 값이 compose 를 거쳐 들어와요.

# MCP 서버 인증 키. 프록시(/api/mcp/<name>)와 Chat 이 X-MCP-API-Key 헤더로 붙입니다.
# MCP 서버의 MCP_API_KEY 와 같은 값이어야 하고, 비우면 헤더를 보내지 않아요.
MCP_API_KEY=

# 레지스트리 yaml 경로. 비우면 ./configs/mcp_servers.yaml, ../configs/mcp_servers.yaml 순으로 찾습니다.
MCP_REGISTRY_PATH=

# Chat 시스템 프롬프트 템플릿 경로. 비우면 configs/prompts/chat_system.md 를 같은 규칙으로 찾습니다.
CHAT_SYSTEM_PROMPT_PATH=

# true 면 서버 측 MCP 호출이 레지스트리의 internalUrl(컨테이너 네트워크 주소)을 씁니다.
# 호스트에서 npm run dev 할 때는 비워 두세요 (url 사용). compose 는 true 로 설정합니다.
MCP_USE_INTERNAL_URL=

# 런타임 서버(Dashboard/Inspector 의 Add server)를 서버 프록시(/api/mcp-runtime)로 연결하고 Chat 에서 쓰려면 true.
# 기본은 꺼짐입니다. 켜면 이 서버가 사용자가 입력한 http/https URL 로 요청을 대신 보내므로 신뢰하는 환경(로컬, 내부망)에서만 켜세요.
# 사용자가 입력한 헤더만 전달하고 위 MCP_API_KEY 는 런타임 대상에 붙이지 않습니다. 꺼져 있으면 브라우저 직결(대상 서버의 CORS 필요)만 쓸 수 있어요.
MCP_ALLOW_RUNTIME_PROXY=
# 선택: 런타임 프록시의 응답 시작 대기 상한(ms, 기본 60000)과 응답 본문 상한(바이트, 기본 10485760)
MCP_RUNTIME_PROXY_TIMEOUT_MS=
MCP_RUNTIME_PROXY_MAX_BYTES=

# Chat LLM 키. Settings 화면에 브라우저 키를 넣지 않았을 때 대신 씁니다.
# 접속한 누구나 이 키를 쓰게 되므로 CHAT_ALLOW_SERVER_KEYS=true 로 명시해야만 사용합니다 (기본 꺼짐).
CHAT_ALLOW_SERVER_KEYS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# e2e 전용: 1 이면 Chat 이 실제 LLM 대신 가짜 LLM 을 씁니다 (키 불필요). 운영에서는 켜지 마세요. README 의 "Chat e2e" 참고.
CHAT_MOCK_LLM=
# NODE_ENV=production(next start, Docker)에서는 위 값만으로 켜지지 않고 아래도 1 이어야 합니다. 로컬 프로덕션 빌드 검증 전용이며 docker-compose 는 전달하지 않아요.
CHAT_MOCK_LLM_ALLOW_PRODUCTION=
