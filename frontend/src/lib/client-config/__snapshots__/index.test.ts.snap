"# vscode-file
{
  "inputs": [
    {
      "type": "promptString",
      "id": "authorization-token",
      "description": "Authorization (token only, Bearer is added)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "x-api-key",
      "description": "X-Api-Key",
      "password": true
    }
  ],
  "servers": {
    "ext-one": {
      "type": "http",
      "url": "https://api.example.com/mcp",
