exports[`client config snapshots > vscode / registry http with key 1`] = `
"# vscode-file
{
  "inputs": [
    {
      "type": "promptString",
      "id": "mcp-api-key",
      "description": "X-MCP-API-Key",
      "password": true
    }
  ],
  "servers": {
    "starter-mcp-http": {
      "type": "http",
      "url": "http://localhost:8001/mcp",
      "headers": {
        "X-MCP-API-Key": "\${input:mcp-api-key}"
      }
    }
  }
}"
`;

