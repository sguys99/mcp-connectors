# 저장소 공용 환경 변수 (cp .env.example .env)
# MCP 서버는 실행 위치와 무관하게 이 루트 .env 를 읽습니다 (_common/env.py).
# 특정 서버만 값을 바꾸려면 src/mcp-servers/<서버>/.env 를 만들어 덮어쓰면 돼요.

MCP_API_KEY=
# Chat LLM 키. docker compose 가 frontend 컨테이너에 넘깁니다 (Settings 에 입력한 브라우저 키가 우선)
# 서버 키는 CHAT_ALLOW_SERVER_KEYS=true 일 때만 씁니다. Frontend 에 접속한 누구나 이 키로 호출할 수 있어서 기본은 꺼짐이에요.
CHAT_ALLOW_SERVER_KEYS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Chat 수동 승인 토큰의 서명 키 (16자 이상). 비우면 프로세스마다 무작위 값을 씁니다.
# Frontend 인스턴스를 여러 개 두거나 재시작 뒤에도 승인을 이어야 할 때만 같은 값을 줍니다.
CHAT_APPROVAL_SECRET=

# 브라우저 직결 시 허용 origin (콤마 구분, 미설정 시 http://localhost:3000)
# 호스트 실행 서버는 이 파일을 다른 설정과 같은 규칙으로 읽고(OS 환경 변수가 우선), Docker Compose 도 이 값을 세 서버에 넘깁니다.
# Frontend 의 Add server(런타임 서버, 브라우저 직결)가 이 저장소의 서버에 붙을 때도 앱 origin 이 여기에 있어야 합니다.
MCP_CORS_ORIGINS=http://localhost:3000

# Frontend: 런타임 서버를 서버 프록시(/api/mcp-runtime)와 Chat 에서 쓰려면 true (기본 꺼짐, 신뢰하는 환경에서만)
MCP_ALLOW_RUNTIME_PROXY=

# ── Starter / Mock Repo MCP ──────────────────────────────────────────────────
STARTER_MCP_PORT=8001
MOCK_REPO_MCP_PORT=8002

# ── NL2SQL MCP ───────────────────────────────────────────────────────────────
NL2SQL_MCP_PORT=8004
NL2SQL_DB_DIALECT=postgres          # postgres(기본) | oracle
NL2SQL_DB_BACKEND=mock              # mock(기본, 실 DB 없이 Pagila 픽스처) | real (호스트에서 직접 실행할 때의 값)
# docker compose 의 nl2sql-mcp 컨테이너 백엔드는 위 값이 아니라 NL2SQL_CONTAINER_BACKEND 를 따릅니다.
# 직접 적지 말고 `make nl2sql-sample-db`(real) / `make nl2sql-mock`(mock) 으로 전환하세요.
# 컨테이너는 postgres 서비스(내부 포트 5432)로 붙으므로 아래 NL2SQL_PG_HOST/PORT 는 호스트 실행에만 쓰입니다.
# PostgreSQL 접속 (backend=real, dialect=postgres). DSN 을 주면 아래 개별 값보다 우선합니다
# 아래 값은 로컬 샘플 DB(`make sample-db-up`, docker-compose.yaml 의 postgres)용입니다.
# compose 도 같은 USER/PASSWORD/PORT 로 읽기 전용 계정과 호스트 포트를 만들어요(값을 바꾸면 `make sample-db-reset`).
NL2SQL_PG_DSN=
NL2SQL_PG_HOST=localhost
NL2SQL_PG_PORT=5432
NL2SQL_PG_DATABASE=pagila
NL2SQL_PG_USER=nl2sql_ro
NL2SQL_PG_PASSWORD=nl2sql_ro_local_sample
# 샘플 DB superuser(postgres) 비밀번호. 초기화 스크립트만 쓰고 서버는 쓰지 않습니다
PAGILA_ADMIN_PASSWORD=pagila_admin_local_sample
# Oracle 접속 (backend=real, dialect=oracle). `uv sync --extra oracle` 필요
NL2SQL_ORACLE_DSN=
NL2SQL_ORACLE_HOST=localhost
NL2SQL_ORACLE_PORT=1521
NL2SQL_ORACLE_SERVICE=ORCL
NL2SQL_ORACLE_USER=nl2sql_ro
NL2SQL_ORACLE_PASSWORD=
