# nl2sql-mcp 환경변수 예시
# 기본은 저장소 루트 .env 하나에 적습니다 (루트 .env.example 참고).
# 이 서버만 값을 바꾸려면 이 파일을 같은 디렉터리의 .env 로 복사해 덮어쓰세요.
# 우선순위: OS 환경 변수 > 패키지 .env > 루트 .env

# ── MCP 서버 ────────────────────────────────────────────────────────────────
NL2SQL_MCP_PORT=8004
MCP_API_KEY=                        # 미설정 시 인증 비활성 (개발용)

# ── DB 종류와 백엔드 ─────────────────────────────────────────────────────────
NL2SQL_DB_DIALECT=postgres          # postgres(기본) | oracle. SQL 문법, 카탈로그 조회, 차단 목록이 바뀝니다
NL2SQL_DB_BACKEND=mock              # mock(기본, Pagila 픽스처) | real(실 DB 접속)

# ── PostgreSQL 접속 (backend=real, dialect=postgres) ─────────────────────────
# 연결은 읽기 전용 트랜잭션(default_transaction_read_only=on)이고
# statement_timeout 은 GUARDRAIL_TIMEOUT_SEC 를 따릅니다.
# 아래 값은 로컬 샘플 DB(`make sample-db-up`)의 읽기 전용 계정입니다. 샘플 DB 를 쓰려면
# NL2SQL_DB_BACKEND=real 로 바꾸면 돼요. 사내 DB 에 붙을 때는 실제 값으로 바꿉니다.
NL2SQL_PG_DSN=                      # 예: postgresql://nl2sql_ro:pw@localhost:5432/pagila (설정 시 아래 값보다 우선)
NL2SQL_PG_HOST=localhost
NL2SQL_PG_PORT=5432                 # 샘플 DB 호스트 포트도 이 값을 따릅니다 (docker-compose.yaml)
NL2SQL_PG_DATABASE=pagila
NL2SQL_PG_USER=nl2sql_ro            # Read-Only 전용 계정
NL2SQL_PG_PASSWORD=nl2sql_ro_local_sample   # 로컬 샘플 전용 값

# ── Oracle 접속 (backend=real, dialect=oracle, `uv sync --extra oracle` 필요) ──
NL2SQL_ORACLE_DSN=                  # 설정 시 HOST/PORT/SERVICE 보다 우선
NL2SQL_ORACLE_HOST=localhost
NL2SQL_ORACLE_PORT=1521
NL2SQL_ORACLE_SERVICE=ORCL
NL2SQL_ORACLE_USER=nl2sql_ro        # Read-Only 전용 계정
NL2SQL_ORACLE_PASSWORD=
NL2SQL_ORACLE_THICK_MODE=false      # Oracle Instant Client 설치 시 true
NL2SQL_ORACLE_CLIENT_LIB_DIR=       # 예: /opt/oracle/instantclient_21_3

# ── 가드레일 임계치 ──────────────────────────────────────────────────────────
GUARDRAIL_MAX_LIMIT=10000
GUARDRAIL_DEFAULT_MONTHS=3
GUARDRAIL_MAX_MONTHS=12
GUARDRAIL_TIMEOUT_SEC=30           # 쿼리 타임아웃(초). Postgres statement_timeout 에도 적용

# optional 가드레일 (true = 활성, false = 비활성)
GUARDRAIL_FORBIDDEN_ENABLED=true    # 7.5 금지 SQL 구문
GUARDRAIL_RISKY_SQL_ENABLED=true    # 7.9 위험 SQL 탐지
GUARDRAIL_REQUIRE_WHERE=true        # 7.7 WHERE 없는 조회는 작은 테이블에서만 허용
GUARDRAIL_MASS_SCAN_ROW_THRESHOLD=10000  # 7.7 WHERE 없이 허용할 테이블의 최대 행 수 추정치 (모르면 큰 테이블)
GUARDRAIL_BLOCK_TAUTOLOGY=true      # 7.7 WHERE 1=1 / TRUE / OR 1=1 무력화 조건 차단
# 7.2 기간 조건을 주입할 테이블별 기간 컬럼 (테이블.컬럼 콤마 목록). 비우면 payment.payment_date,rental.rental_date
GUARDRAIL_DATE_COLUMNS=

# Mock 백엔드 execute_query 지연(초). 타임아웃(7.4)을 Mock 으로 재현할 때만 씁니다
NL2SQL_MOCK_DELAY_SEC=0

# ── PII 통제 (7.6, 테이블 인지형) ─────────────────────────────────────────────
# 비워 두면 Pagila 기본 카탈로그(nl2sql_mcp/pii_catalog.py)를 씁니다.
# 값을 주면 기본값을 통째로 대체합니다. 형식: 테이블.컬럼[:block|mask] 콤마 목록 (조치 생략 시 block)
# 예: PII_CATALOG_RAW=member.email:block,member.phone:block,member.nickname:mask
PII_CATALOG_RAW=

# ── 감사 로그 (7.8) ───────────────────────────────────────────────────────────
# 비워 두면 <저장소>/var/nl2sql_mcp/audit.db (gitignore). 상대 경로는 저장소 루트 기준으로 풉니다.
# 컨테이너에서는 /app/var 에 볼륨을 붙이거나 마운트한 경로를 지정하세요.
AUDIT_LOG_PATH=
AUDIT_RETENTION_DAYS=30
